manifest {
  name            = 'Promotheus-nextflow'
  author          = 'Promotheus contributors'
  homePage        = 'https://github.com/Ste40/Promotheus'
  description     = 'Reproducible Nextflow orchestration for Promotheus'
  version         = '2.0.0'
  nextflowVersion = '>=23.10.0'
}

params {
  input_dir = null
  output_dir = 'results'
  container_image = 'ste40/promotheus@sha256:a7c5196b4ebf6f93ef8a4ff2698481d24e3f63306c9eaccd413bce3c48eebec7'
  container_platform = 'linux/amd64'
  engine = 'docker'
  threads = 8
  memory = 4000
  correction_de = 'none'
  pvalue = 0.05
  operons_detection = true
  amino_diff = 3
  similarity = 30
  asmcode = null
  operons_threshold = 3
  multitaxa = false
  max_gse_parallel = 2
  max_orthology_parallel = 4
  orthology_cpus = 1
  orthology_memory = 3000
  orthology_genomes = null
  cache_dir = null
  keep_cache = true
  export_tsv = true
  task_cpus = null
  task_memory = null
  mock_delay = 0
  mock_fail_stage = ''
  mock_fail_gse = ''
}

def report_timestamp = new Date().format('yyyy-MM-dd_HH-mm-ss')
def pipeline_info_dir = "${params.output_dir}/pipeline_info"

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  cpus = 1
  memory = '512 MB'
  withLabel: scientific {
    cpus = { params.task_cpus ?: Math.max(1, (int)((params.threads as int) / (params.max_gse_parallel as int))) }
    memory = { "${params.task_memory ?: Math.max(512, (int)((params.memory as int) / (params.max_gse_parallel as int)))} MB" }
  }
  withLabel: orthology_pair {
    cpus = { params.orthology_cpus as int }
    memory = { "${params.orthology_memory} MB" }
  }
}

executor {
  cpus = params.threads as int
  memory = "${params.memory} MB"
  queueSize = Math.max(params.max_gse_parallel as int, params.max_orthology_parallel as int)
}

profiles {
  standard {
    params.engine = 'docker'
  }

  test {
    params.engine = 'mock'
    process.cpus = 1
    process.memory = '512 MB'
    params.orthology_memory = 512
  }
}

timeline {
  enabled = true
  file = "${pipeline_info_dir}/execution_timeline_${report_timestamp}.html"
  overwrite = true
}

report {
  enabled = true
  file = "${pipeline_info_dir}/execution_report_${report_timestamp}.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${pipeline_info_dir}/execution_trace_${report_timestamp}.txt"
  fields = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,vol_ctxt,inv_ctxt,workdir,submit,start,complete'
  overwrite = true
}

dag {
  enabled = true
  file = "${pipeline_info_dir}/pipeline_dag_${report_timestamp}.html"
  overwrite = true
}

#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "info" ]]; then
  exit 0
fi
if [[ "${1:-}" != "run" ]]; then
  echo "Unexpected fake Docker command: $*" >&2
  exit 2
fi
if [[ -z "${PROMOTHEUS_DOCKER_LOG:-}" ]]; then
  echo "PROMOTHEUS_DOCKER_LOG is required" >&2
  exit 2
fi

printf '%s\n' "$@" > "$PROMOTHEUS_DOCKER_LOG"
cat >/dev/null
